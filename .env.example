# Shared Telegram API credentials: https://my.telegram.org
API_ID=
API_HASH=
# Your own numeric Telegram user ID (not the bot's ID); /ping checks this.
OWNER_ID=

# MongoDB Atlas or compatible MongoDB URI
MONGO_URL=

# Use separate Telegram bots/tokens for the two services.
RSS_BOT_TOKEN=
ANIME_BOT_TOKEN=

# Required channels for the existing RSS publisher.
RSS_MAIN_CHANNEL=-1000000000000
RSS_LOG_CHANNEL=-1000000000000
RSS_CLOUD_CHANNEL=-1000000000000
RSS_BACKUP_CHANNEL=-1000000000000
RSS_FORCESUB_CHANNEL=0
RSS_FORCESUB_CHANNEL_LINK=
RSS_SESSION=
RSS_THUMBNAIL=
RSS_FFMPEG=ffmpeg
RSS_CRF=27
RSS_LOG_ON_MAIN=False
RSS_SEND_SCHEDULE=False
RSS_RESTART_EVERDAY=False
RSS_DELETE_FILES_FROM_PMS=True

# Interactive AniWatch/Animetsu downloader.
# Optional channel IDs may be left blank; manual downloads then go to the requesting chat.
ANIME_MAIN_CHANNEL=
ANIME_LOG_CHANNEL=
ANIME_TARGET_CHAT_ID=
ANIME_SET_INTERVAL=3600
ANIME_MONGO_NAME=cantarellabots
ANIME_BOT_USERNAME=
ANIME_FSUB_PIC=
ANIME_FSUB_LINK_EXPIRY=600
ANIME_START_PIC=
ANIME_HEALTH_PORT=8080

# Optional scraper proxy entries can be added one per line in proxies.txt.
